{
  "mcpServers": {
    "cohors": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/cohors-launch.sh",
        "mcp"
      ],
      "env": {
        "CLAUDE_PLUGIN_OPTION_GIT_ACTIONS": "${user_config.git_actions}",
        "CLAUDE_PLUGIN_OPTION_RUN_COMMANDS": "${user_config.run_commands}",
        "CLAUDE_PLUGIN_OPTION_LAUNCHPAD_WRITES": "${user_config.launchpad_writes}"
      }
    }
  }
}
