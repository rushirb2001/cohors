{
  "name": "cohors",
  "displayName": "cohors",
  "description": "The state of every git repository you own, and what to do next, in one editor tab. Needs the cohors command-line tool.",
  "version": "0.7.1",
  "publisher": "rushirb2001",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rushirb2001/cohors",
    "directory": "extension"
  },
  "homepage": "https://github.com/rushirb2001/cohors#readme",
  "bugs": {
    "url": "https://github.com/rushirb2001/cohors/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "multi-repo",
    "dashboard",
    "standup",
    "agents"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace cohors still shows your repositories and can run its own fetch, pull, push, commit and stash. Every flow is disabled, whether a repository declared it or it was detected from the repository's scripts, and so is every agent and task a repository declares. The workspace also cannot set which folders are scanned: its cohors.roots setting is ignored, and the open folder is not used to find your repositories.",
      "restrictedConfigurations": [
        "cohors.roots"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "cohors.show",
        "title": "cohors: Open dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "cohors.refresh",
        "title": "cohors: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "cohors.fetchAll",
        "title": "cohors: Fetch every repository"
      },
      {
        "command": "cohors.setupRepo",
        "title": "cohors: Set up this repo with an agent"
      },
      {
        "command": "cohors.planDay",
        "title": "cohors: Plan my day with an agent"
      },
      {
        "command": "cohors.useWorkspaceRoots",
        "title": "cohors: Use this workspace's folders as roots"
      },
      {
        "command": "cohors.showContract",
        "title": "cohors: Show the launchpad contract"
      },
      {
        "command": "cohors.openSettings",
        "title": "cohors: Open settings"
      },
      {
        "command": "cohors.installHelp",
        "title": "cohors: How to install the cohors command-line tool"
      }
    ],
    "keybindings": [
      {
        "command": "cohors.show",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cohors",
          "title": "cohors",
          "icon": "media/cohors.svg"
        }
      ]
    },
    "views": {
      "cohors": [
        {
          "type": "webview",
          "id": "cohors.fleet",
          "name": "Overview",
          "initialSize": 3
        },
        {
          "type": "webview",
          "id": "cohors.next",
          "name": "Do next",
          "initialSize": 4
        },
        {
          "type": "webview",
          "id": "cohors.risk",
          "name": "Work at risk",
          "initialSize": 4
        },
        {
          "type": "webview",
          "id": "cohors.tasks",
          "name": "Open tasks",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "cohors.commits",
          "name": "Commits, 7 days",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "cohors.repos",
          "name": "Repositories",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "cohors.show",
          "when": "view == cohors.fleet",
          "group": "navigation@1"
        },
        {
          "command": "cohors.refresh",
          "when": "view == cohors.fleet",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "cohors",
      "properties": {
        "cohors.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the `cohors` command-line tool. Leave empty to find `cohors` on your login shell's `PATH`."
        },
        "cohors.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders to scan for repositories. Leave empty to use the roots in your cohors config file. The command **cohors: Use this workspace's folders as roots** fills this in for the current workspace."
        },
        "cohors.refreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Seconds between background refreshes. It only ticks while the dashboard tab is focused, and file changes in the open workspace refresh it straight away. 0 turns polling off."
        },
        "cohors.openOnStartup": {
          "type": "string",
          "enum": [
            "off",
            "sidebar",
            "dashboard",
            "both"
          ],
          "default": "off",
          "enumDescriptions": [
            "Open nothing; cohors waits in the activity bar.",
            "Bring the cohors sidebar forward.",
            "Open the dashboard tab.",
            "Open the dashboard tab and bring the sidebar forward."
          ],
          "description": "What cohors opens when a window starts."
        }
      }
    }
  },
  "icon": "media/icon.png"
}
